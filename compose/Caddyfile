# Caddy 反代配置：同一个域名下同时提供 ZTNet 面板与 planet 下载。
# 由 docker-compose.yml 的 tls profile 挂载到 /etc/caddy/Caddyfile，
# 域名来自环境变量 TLS_DOMAIN（deploy.sh --domain 或 .env 里填）。
{$TLS_DOMAIN} {
	encode zstd gzip

	# 文件服务：客户端安装脚本 / Android 只用 Authorization: Bearer，
	# 这里原样透传请求头与查询串（?token=），不要改成 rewrite。
	@planet path /planet /moons /moon/* /healthz
	handle @planet {
		reverse_proxy zerotier:3000
	}

	# 其余全部交给 ZTNet 面板
	handle {
		reverse_proxy ztnet:3000
	}
}
