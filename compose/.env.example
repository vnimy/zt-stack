# ============================================================================
# zt-stack 配置模板
#   cp .env.example .env 后按注释改，或直接用 ../scripts/deploy.sh -i <公网IP>
#   deploy.sh 会复制本文件、自动生成随机口令，并保留已存在的 .env。
#   本文件里出现的值都会被 docker compose 插值，注释必须以 # 开头。
# ============================================================================

# --- 根节点公网端点（必填）---------------------------------------------------
# 服务器公网 IPv4。会被写进 planet 的 stableEndpoints，客户端就是连这个地址。
PUBLIC_IPV4=
# 可选公网 IPv6；为空则不写入 planet（只通告 IPv4）。填了要确保防火墙放行 UDP。
PUBLIC_IPV6=

# --- 端口 -------------------------------------------------------------------
# 公网 peer/API 端口：容器内固定 9993，这里是宿主映射端口，也是写进 planet 的端口。
# 客户端走 UDP，这个端口必须对公网放行 tcp+udp。
ZT_PORT=9994
# planet 下载服务端口（GET /planet、/healthz）：客户端与安装脚本用，放行 tcp。
FILES_PORT=3000
# ZTNet 面板端口（http）。默认 3001（3000 留给 planet 下载服务）。
# 用 caddy/tls profile 时可只在内网保留。
ZTNET_PORT=3001

# --- 下载凭据 ---------------------------------------------------------------
# 非空则 /planet、/moons、/moon/* 需要凭据：?token=xxx 或 Authorization: Bearer xxx；
# /healthz 永远不需要。留空 = 不校验（任何人都能下载 planet）。
DOWNLOAD_TOKEN=

# --- ZTNet ------------------------------------------------------------------
# 浏览器访问面板用的完整 URL（例如 http://203.0.113.10:3001），deploy.sh 会按 IP 自动填。
# 它必须等于浏览器实际访问的地址，否则 ZTNet 的登录会被 Origin 校验拒成 403。
NEXTAUTH_URL=
# NextAuth 签名密钥，任何 32+ 位随机串都行；deploy.sh 用 openssl rand 生成。
NEXTAUTH_SECRET=
# ZTNet 调控制器的地址。默认 http://zerotier:9993（容器名/主机名），一般不用改。
ZT_ADDR=http://zerotier:9993

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ztnet

# --- 镜像 -------------------------------------------------------------------
# 可直接换成官方地址：sinamics/ztnet:latest、postgres:15-alpine、caddy:2-alpine
ZTNET_IMAGE=docker.1panel.live/sinamics/ztnet:latest
POSTGRES_IMAGE=docker.1panel.live/library/postgres:15-alpine
CADDY_IMAGE=docker.1panel.live/library/caddy:2-alpine
PLANET_NODE_TAG=1.16.2

# --- 网络 / 访问控制 --------------------------------------------------------
# compose 内部子网，必须落在 ALLOW_MANAGEMENT_FROM 覆盖范围内。
STACK_SUBNET=172.28.0.0/24
# 允许调用 9993 管理/控制 API 的来源网段（逗号分隔，可多个）。
# 默认 172.16.0.0/12 覆盖上面的默认子网；loopback 永远允许。
ALLOW_MANAGEMENT_FROM=172.16.0.0/12

# --- TLS（可选，需要 docker compose --profile tls）--------------------------
# 域名必须已解析到本机公网 IP，Caddy 会自动申请证书。
# 启用后：https://<域名>/ 是 ZTNet 面板，https://<域名>/planet 是 planet 下载。
TLS_DOMAIN=

# --- 危险开关 ---------------------------------------------------------------
# 1 = 下次启动**只**重写 planet/moons（新端点+新时间戳）：identity.secret、authtoken.secret、
#     controller.d/、networks.d/、签名密钥全部保留 -> network id 与成员授权不变，
#     但 planet 里的端点变了，所有成员必须重新下载 planet。authtoken 不变，ZTNet 不用重启。
# deploy.sh 检测到 PUBLIC_IPV4 变更时临时置 1，成功启动后自动改回 0。
REGENERATE_WORLD=0
# 1 = 全量重建：换新 identity -> 所有自建网络 ID 失效，成员必须重新 join。
# 只在 deploy.sh --force-new-identity 时临时置 1；与 REGENERATE_WORLD 同时为 1 时本项优先。
FORCE_REGENERATE=0
