From a24fb8b2a041222640ecd466b9b44eff103a877c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E6=9D=A8=E5=98=89=E7=A5=A5?= <vnimy@live.com>
Date: Wed, 11 Nov 2026 10:23:03 +0800
Subject: [PATCH] build: JDK17 + Gradle 8.7 + AGP 8.6.1 + compileSdk/targetSdk
 35
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- AGP 7.4.2 -> 8.6.1，wrapper 7.5 -> 8.7（腾讯云镜像，services.gradle.org 不可达）
- greendao-gradle-plugin 3.3.0 -> 3.3.1（3.3.0 使用 Gradle 8 已移除的 IncrementalTaskInputs）
- lombok 1.18.20 -> 1.18.34（旧版本不支持 JDK17 编译）
- compileSdk/targetSdk 33 -> 35，minSdk 19 -> 21（NDK r28 只支持 API 21+）
- app 打开 buildFeatures.buildConfig（AGP 8 默认关闭）
- core 模块补 namespace，改为显式 java.srcDirs（上游软链接在 Windows 上落成普通文件），
  buildToolsVersion 35.0.0、ndkVersion 28.2.13676358、只构建 arm64-v8a/armeabi-v7a
- 仓库优先走阿里云镜像，回落到 google()/mavenCentral()
---
 app/build.gradle                         | 11 ++++++++---
 build.gradle                             | 23 +++++++++++++++--------
 core/build.gradle                        | 24 +++++++++++++++++++++---
 core/src/main/AndroidManifest.xml        |  3 +--
 core/src/main/java                       |  1 -
 gradle/wrapper/gradle-wrapper.properties |  4 ++--
 6 files changed, 47 insertions(+), 19 deletions(-)
 delete mode 120000 core/src/main/java

diff --git a/app/build.gradle b/app/build.gradle
index a8cd7af..4db6bf6 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -9,7 +9,8 @@ greendao {
 }
 
 android {
-    compileSdkVersion rootProject.ext.compileSdkVersion
+    compileSdk rootProject.ext.compileSdkVersion
+    buildToolsVersion '35.0.0'
 
     defaultConfig {
         applicationId "net.kaaass.zerotierfix"
@@ -34,6 +35,10 @@ android {
         coreLibraryDesugaringEnabled true
     }
 
+    buildFeatures {
+        // AGP 8 默认关闭 BuildConfig 生成，NetworkListFragment/DebugLog 依赖它
+        buildConfig true
+    }
     configurations {
         all {
             exclude module: 'httpclient'
@@ -65,6 +70,6 @@ dependencies {
     implementation 'commons-validator:commons-validator:1.7'
     implementation "androidx.multidex:multidex:2.0.1"
     //noinspection AnnotationProcessorOnCompilePath
-    compileOnly 'org.projectlombok:lombok:1.18.20'
-    annotationProcessor 'org.projectlombok:lombok:1.18.20'
+    compileOnly 'org.projectlombok:lombok:1.18.34'
+    annotationProcessor 'org.projectlombok:lombok:1.18.34'
 }
\ No newline at end of file
diff --git a/build.gradle b/build.gradle
index 7e03306..20b8e25 100644
--- a/build.gradle
+++ b/build.gradle
@@ -1,12 +1,16 @@
 // Top-level build file where you can add configuration options common to all sub-projects/modules.
 buildscript {
     repositories {
+        // 国内镜像优先，命中失败时 Gradle 会自动回落到 google()/mavenCentral()
+        maven { url 'https://maven.aliyun.com/repository/google' }
+        maven { url 'https://maven.aliyun.com/repository/public' }
         google()
         mavenCentral()
     }
     dependencies {
-        classpath 'com.android.tools.build:gradle:7.4.2'
-        classpath "org.greenrobot:greendao-gradle-plugin:3.3.0"
+        classpath 'com.android.tools.build:gradle:8.6.1'
+        // 3.3.0 使用 Gradle 8 已移除的 IncrementalTaskInputs，必须用 3.3.1
+        classpath "org.greenrobot:greendao-gradle-plugin:3.3.1"
 
         // NOTE: Do not place your application dependencies here; they belong
         // in the individual module build.gradle files
@@ -15,17 +19,20 @@ buildscript {
 
 allprojects {
     repositories {
+        maven { url 'https://maven.aliyun.com/repository/google' }
+        maven { url 'https://maven.aliyun.com/repository/public' }
         google()
         mavenCentral()
     }
 }
 
 ext {
-    compileSdkVersion = 33
-    minSdkVersion = 19
-    targetSdkVersion = 33
+    compileSdkVersion = 35
+    // NDK r28 只支持 API 21+（meta/platforms.json: min=21），因此 minSdk 从 19 上调到 21
+    minSdkVersion = 21
+    targetSdkVersion = 35
 }
 
-task clean(type: Delete) {
-    delete rootProject.buildDir
-}
\ No newline at end of file
+tasks.register('clean', Delete) {
+    delete rootProject.layout.buildDirectory
+}
diff --git a/core/build.gradle b/core/build.gradle
index eb79e38..5266224 100644
--- a/core/build.gradle
+++ b/core/build.gradle
@@ -2,14 +2,23 @@ plugins {
     id 'com.android.library'
 }
 
+// NDK 由 local.properties 的 ndk.dir 指定（SDK 内 NDK 目录名是 android-ndk-r28c 而不是版本号，
+// 只写 ndkVersion 时 AGP 会去 ndk/28.2.13676358 找并在找不到时尝试安装）
 android {
-    compileSdkVersion rootProject.ext.compileSdkVersion
+    namespace 'com.zerotier.sdk'
+    compileSdk rootProject.ext.compileSdkVersion
+    buildToolsVersion '35.0.0'
+    ndkVersion '28.2.13676358'
 
     defaultConfig {
-        minSdkVersion rootProject.ext.minSdkVersion
-        targetSdkVersion rootProject.ext.targetSdkVersion
+        minSdk rootProject.ext.minSdkVersion
+        targetSdk rootProject.ext.targetSdkVersion
         versionCode 1
         versionName "1.0"
+        // 交付产物面向手机，只构建两个 ARM ABI（同时显著缩短内核编译时间）
+        ndk {
+            abiFilters 'arm64-v8a', 'armeabi-v7a'
+        }
 
         testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
     }
@@ -25,9 +34,18 @@ android {
         targetCompatibility JavaVersion.VERSION_1_8
     }
 
+    // 上游用软链接把 core/src/main/java 指向 externals/core/java/src，
+    // Windows 检出会把软链接落成普通文本文件，这里显式声明源码目录。
+    sourceSets {
+        main {
+            java.srcDirs = ['../externals/core/java/src']
+        }
+    }
+
     externalNativeBuild {
         cmake {
             path file('../externals/core/java/CMakeLists.txt')
+            // 实际使用的 CMake 由 local.properties 的 cmake.dir 指定（3.22.1）
             version '3.22.1'
         }
     }
diff --git a/core/src/main/AndroidManifest.xml b/core/src/main/AndroidManifest.xml
index 633b81e..b2d3ea1 100644
--- a/core/src/main/AndroidManifest.xml
+++ b/core/src/main/AndroidManifest.xml
@@ -1,3 +1,2 @@
 <?xml version="1.0" encoding="utf-8"?>
-<manifest package="com.zerotier.sdk">
-</manifest>
\ No newline at end of file
+<manifest xmlns:android="http://schemas.android.com/apk/res/android" />
diff --git a/core/src/main/java b/core/src/main/java
deleted file mode 120000
index bdeafe9..0000000
--- a/core/src/main/java
+++ /dev/null
@@ -1 +0,0 @@
-../../../externals/core/java/src
\ No newline at end of file
diff --git a/gradle/wrapper/gradle-wrapper.properties b/gradle/wrapper/gradle-wrapper.properties
index 29a74f3..6a0c3f6 100644
--- a/gradle/wrapper/gradle-wrapper.properties
+++ b/gradle/wrapper/gradle-wrapper.properties
@@ -1,6 +1,6 @@
-#Wed Apr 07 08:21:43 CST 2021
 distributionBase=GRADLE_USER_HOME
 distributionPath=wrapper/dists
+# 使用腾讯云镜像：services.gradle.org 在部分网络下不可达
+distributionUrl=https\://mirrors.cloud.tencent.com/gradle/gradle-8.7-bin.zip
 zipStoreBase=GRADLE_USER_HOME
 zipStorePath=wrapper/dists
-distributionUrl=https\://services.gradle.org/distributions/gradle-7.5-all.zip
-- 
2.55.0.windows.5

