 java/CMakeLists.txt | 34 +++++++++++++++++++++++++++-------
 1 file changed, 27 insertions(+), 7 deletions(-)

diff --git a/java/CMakeLists.txt b/java/CMakeLists.txt
index 008b747b..f188954b 100644
--- a/java/CMakeLists.txt
+++ b/java/CMakeLists.txt
@@ -2,6 +2,10 @@ cmake_minimum_required(VERSION 3.2)
 
 project(ZeroTierOneJNI)
 
+# ZeroTier 1.16.x core 使用 C++17（对照 make-linux.mk 的 -std=c++17）
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
 find_package(Java COMPONENTS Development)
 message("JAVA_HOME: $ENV{JAVA_HOME}")
 
@@ -25,30 +29,42 @@ if(APPLE)
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${CMAKE_C_FLAGS} -fno-rtti")
 endif()
 
+# 与 objects.mk 的 CORE_OBJS 对齐（1.16.x：C25519/Defaults/Dictionary 已移除，新增 ECC、AES、
+# Bond、Capability、CertificateOfOwnership、Metrics、PacketMultiplexer、Path、Revocation、Tag、Trace）。
+# AES_aesni.cpp 与 AES_armcrypto.cpp 各自被 ZT_AES_AESNI / ZT_AES_NEON 保护，同时编译是安全的。
 set(src_files
-    ../ext/lz4/lz4.c
-    ../ext/json-parser/json.c
     ../ext/http-parser/http_parser.c
-    ../node/C25519.cpp
+    ../node/AES.cpp
+    ../node/AES_aesni.cpp
+    ../node/AES_armcrypto.cpp
+    ../node/Bond.cpp
+    ../node/Capability.cpp
     ../node/CertificateOfMembership.cpp
-    ../node/Defaults.cpp
-    ../node/Dictionary.cpp
+    ../node/CertificateOfOwnership.cpp
+    ../node/ECC.cpp
     ../node/Identity.cpp
     ../node/IncomingPacket.cpp
     ../node/InetAddress.cpp
+    ../node/Membership.cpp
+    ../node/Metrics.cpp
     ../node/Multicaster.cpp
     ../node/Network.cpp
     ../node/NetworkConfig.cpp
     ../node/Node.cpp
     ../node/OutboundMulticast.cpp
     ../node/Packet.cpp
+    ../node/PacketMultiplexer.cpp
+    ../node/Path.cpp
     ../node/Peer.cpp
     ../node/Poly1305.cpp
+    ../node/Revocation.cpp
     ../node/Salsa20.cpp
     ../node/SelfAwareness.cpp
     ../node/SHA512.cpp
     ../node/Switch.cpp
+    ../node/Tag.cpp
     ../node/Topology.cpp
+    ../node/Trace.cpp
     ../node/Utils.cpp
     ../osdep/Http.cpp
     ../osdep/OSUtils.cpp
@@ -60,6 +76,10 @@ set(src_files
 set(include_dirs
     ${CMAKE_CURRENT_SOURCE_DIR}/../include/
     ${CMAKE_CURRENT_SOURCE_DIR}/../node/
+    ${CMAKE_CURRENT_SOURCE_DIR}/../ext/
+    ${CMAKE_CURRENT_SOURCE_DIR}/../ext/prometheus-cpp-lite-1.0/core/include/
+    ${CMAKE_CURRENT_SOURCE_DIR}/../ext/prometheus-cpp-lite-1.0/simpleapi/include/
+    ${CMAKE_CURRENT_SOURCE_DIR}/../ext/prometheus-cpp-lite-1.0/3rdparty/http-client-lite/include/
     ${Java_INCLUDE_DIRS})
 
 if(WIN32)
@@ -78,7 +98,7 @@ if(APPLE)
     set_target_properties(${PROJECT_NAME} PROPERTIES SUFFIX ".jnilib")
 endif()
 
-set(link_libs )
+set(link_libs log)
 
 if(WIN32)
     set(link_libs
@@ -88,4 +108,4 @@ if(WIN32)
         )
 endif()
 
-target_link_libraries(${PROJECT_NAME} ${link_libs})
\ No newline at end of file
+target_link_libraries(${PROJECT_NAME} ${link_libs})
